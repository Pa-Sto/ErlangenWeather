{
  "version": "0.1",
  "model_name": "Transformer-Patch-128x4",
  "location": {
    "city": "Erlangen",
    "lat": 49.59,
    "lon": 11.0
  },
  "training_data": {
    "archive_cache": "historical_data.csv",
    "span": [
      "1941-03-04",
      "2026-06-01"
    ],
    "archive_span": [
      "1941-03-04T00:00:00",
      "2026-06-01T23:00:00"
    ],
    "archive_rows": 747264,
    "sources": [
      {
        "name": "Open-Meteo ERA5 Archive",
        "url": "https://archive-api.open-meteo.com/v1/archive"
      },
      {
        "name": "Open-Meteo Forecast API",
        "url": "https://api.open-meteo.com/v1/forecast"
      }
    ],
    "notes": "Archive data are used for cache/evaluation; forecast data are used for daily prediction features."
  },
  "input": {
    "window_days": 10,
    "window_hours": 240,
    "window_stride_hours": 24,
    "shape": [
      240,
      28
    ],
    "scaling": "zscore per feature",
    "features": [
      "temperature_2m",
      "relativehumidity_2m",
      "pressure_msl",
      "windspeed_10m",
      "winddirection_10m",
      "cloudcover",
      "shortwave_radiation",
      "precipitation",
      "rain",
      "hour",
      "dow",
      "doy",
      "hour_sin",
      "hour_cos",
      "dow_sin",
      "dow_cos",
      "doy_sin",
      "doy_cos",
      "month",
      "month_sin",
      "month_cos",
      "timestamp",
      "wind_u_10m",
      "wind_v_10m",
      "dewpoint_2m",
      "dp_dt_3h",
      "temp_prev_day",
      "temp_delta_prev_day"
    ],
    "feature_groups": {
      "weather": [
        "temperature_2m",
        "relativehumidity_2m",
        "pressure_msl",
        "windspeed_10m",
        "winddirection_10m",
        "cloudcover",
        "shortwave_radiation",
        "precipitation",
        "rain"
      ],
      "time": [
        "hour",
        "dow",
        "doy",
        "hour_sin",
        "hour_cos",
        "dow_sin",
        "dow_cos",
        "doy_sin",
        "doy_cos",
        "month",
        "month_sin",
        "month_cos",
        "timestamp"
      ],
      "derived": [
        "wind_u_10m",
        "wind_v_10m",
        "dewpoint_2m",
        "dp_dt_3h",
        "temp_prev_day",
        "temp_delta_prev_day"
      ]
    }
  },
  "output": {
    "horizon_hours": 72,
    "shape": [
      72,
      3
    ],
    "targets": [
      {
        "name": "temperature_2m",
        "unit": "C",
        "key": "temp_c"
      },
      {
        "name": "rain",
        "unit": "mm/h",
        "key": "rain_mm"
      },
      {
        "name": "cloudcover",
        "unit": "%",
        "key": "cloudcover_pct"
      }
    ]
  },
  "architecture": {
    "type": "Transformer encoder with Conv1D patching and global average pooling",
    "patching": {
      "kernel": 4,
      "stride": 2
    },
    "d_model": 128,
    "layers": 4,
    "heads": 4,
    "ffn_dim": 256,
    "dropout": 0.1
  },
  "optimization": {
    "optimizer": "Adam",
    "learning_rate": 0.0003,
    "loss": "weighted_mse_multi",
    "epochs": 100,
    "batch_size": 64
  },
  "files": {
    "current": "site/data/current/",
    "history": "site/data/history/",
    "metrics": "site/data/current/metrics.json"
  },
  "links": {
    "project_repo": "https://github.com/Pa-Sto/ErlangenWeather",
    "data_docs": "https://open-meteo.com/en/docs"
  }
}
