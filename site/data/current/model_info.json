{
  "version": "2.0",
  "model_name": "Transformer-Patch-128x4",
  "location": { "city": "Erlangen", "lat": 49.59, "lon": 11.00 },

  "training_data": {
    "span": ["1979-01-01", "2025-08-15"],
    "sources": [
      { "name": "Open-Meteo ERA5 Archive", "url": "https://archive-api.open-meteo.com/v1/archive" },
      { "name": "Open-Meteo Forecast API", "url": "https://api.open-meteo.com/v1/forecast" }
    ],
    "notes": "Archive used for training/metrics; forecast used for near-real-time features and daily predictions"
  },

  "input": {
    "window_days": 10,
    "window_hours": 240,
    "window_stride_hours": 1,
    "scaling": "zscore per feature",
    "features": [
      "temperature_2m", "relativehumidity_2m", "pressure_msl",
      "windspeed_10m", "winddirection_10m", "cloudcover", "shortwave_radiation",
      "wind_u_10m", "wind_v_10m", "dewpoint_2m", "dp_dt_3h",
      "temp_prev_day", "temp_delta_prev_day",
      "hour_sin", "hour_cos", "dow_sin", "dow_cos", "doy_sin", "doy_cos"
    ]
  },

  "output": {
    "horizon_hours": 72,
    "targets": [
      { "name": "temperature_2m", "unit": "°C", "key": "temp_c" },
      { "name": "rain", "unit": "mm/h", "key": "rain_mm_per_h" },
      { "name": "cloudcover", "unit": "%", "key": "cloudcover_pct" }
    ]
  },

  "architecture": {
    "type": "Transformer encoder (patching + GAP)",
    "patching": { "kernel": 4, "stride": 2 },
    "d_model": 128,
    "layers": 4,
    "heads": 4,
    "ffn_dim": 256,
    "dropout": 0.1
  },

  "optimization": {
    "optimizer": "Adam (legacy)",
    "learning_rate": 0.0003,
    "loss": "weighted_mse_multi",
    "epochs": 100,
    "early_stopping": { "enabled": false, "patience": 10, "restore_best_weights": false }
  },

  "files": {
    "predictions": ["prediction.json", "prediction_multi.json", "prediction_point.json"],
    "metrics": "metrics.json"
  },

  "links": {
    "project_repo": "https://github.com/Pa-Sto/ErlangenWeather",
    "data_docs": "https://open-meteo.com/en/docs"
  }
}